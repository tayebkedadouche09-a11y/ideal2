# Database
DATABASE_URL=postgres://companyos:companyos@localhost:5432/companyos

# Auth
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000

# Storage
STORAGE_PROVIDER=local
STORAGE_DIR=./data/storage
# Supabase Storage (use only server-side; never expose the service-role key to the browser)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=company-documents

# Legacy S3-compatible placeholders
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=company-os-documents
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me

# Cache / queue
REDIS_URL=redis://localhost:6379

# AI (LLM provider) — keys stay server-side only
LLM_PROVIDER=none
LLM_API_KEY=
EMBEDDING_PROVIDER=none

# n8n — scoped service account credentials only, never direct DB access
N8N_WEBHOOK_SECRET=change-me

# Company defaults (configurable, never hardcoded fiscal assumptions)
DEFAULT_LOCALE=fr
DEFAULT_CURRENCY=DZD
